generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int       @id @default(autoincrement())
  name       String
  email      String    @unique
  password   String
  university String?
  campus     String?
  createdAt  DateTime  @default(now())

  listings   Listing[] @relation("UserListings")
}

model Listing {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  price       Float
  category    String
  university  String?
  campus      String?
  createdAt   DateTime  @default(now())

  sellerId    Int
  seller      User     @relation("UserListings", fields: [sellerId], references: [id])
}